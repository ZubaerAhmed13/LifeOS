    async runRule450Tests(repo){
      const engine=new RuleEngine(repo,{undo:new UndoManager(repo),journal:new OperationJournal(repo),operationLocks:new OperationLockManager(repo,'rule-selftest'),notifications:{notify:async()=>({})},bus:new EventBus()});
      const valid={id:'rule-valid',name:'Critical rule',description:'Self-test',enabled:true,trigger:{type:'task-overdue',config:{}},conditionMode:'all',conditions:[{field:'task.priority',operator:'equals',value:'Critical'}],actions:[{type:'surface-what-now',params:{level:'urgent'}}],priority:90,scope:{},executionPolicy:'automatic',source:'manual',schemaVersion:1,ruleEngineVersion:RULE_ENGINE_VERSION};
      await this.test('Rule Schema','valid complete rule',()=>this.assert(DataValidator.rule(valid).ruleEngineVersion==='4.5.0'));
      const invalidCases=[['missing name',r=>({...r,name:''}),'RULE-NAME-001'],['missing trigger',r=>({...r,trigger:{}}),'RULE-TRIGGER-003'],['unknown trigger',r=>({...r,trigger:{type:'unknown'}}),'RULE-TRIGGER-003'],['invalid operator',r=>({...r,conditions:[{field:'task.priority',operator:'gt',value:2}]}),'RULE-CONDITION-OPERATOR-007'],['invalid action',r=>({...r,actions:[{type:'unknown'}]}),'RULE-ACTION-010'],['priority -1',r=>({...r,priority:-1}),'RULE-PRIORITY-011'],['priority 200',r=>({...r,priority:200}),'RULE-PRIORITY-011'],['malformed condition',r=>({...r,conditions:[null]}),'RULE-CONDITION-005']];
      for(const [name,mutate,code] of invalidCases)await this.test('Rule Schema',name,()=>{let actual='';try{DataValidator.rule(mutate(valid))}catch(error){actual=error.code}this.assert(actual===code)});
      const taskBefore={id:'rule-trigger-task',title:'Trigger',status:'Next',priority:'High',estimatedDuration:30,minimumSessionDuration:15,maximumSessionDuration:60,blockedBy:[],postponeCount:0,revision:1},taskAfter={...taskBefore,status:'Completed',priority:'Critical',postponeCount:1,deadline:'2030-01-01',projectId:'p1',revision:2},events=engine.diffStore('tasks',new Map([[taskBefore.id,taskBefore]]),new Map([[taskAfter.id,taskAfter]])),types=events.map(row=>row.type);
      await this.test('Rule Trigger','task status and completion classified',()=>this.assert(types.includes('task-status-changed')&&types.includes('task-completed')));
      await this.test('Rule Trigger','task postponement classified',()=>this.assert(types.includes('task-postponed')));
      await this.test('Rule Trigger','deadline priority and project changes classified',()=>this.assert(['task-deadline-changed','task-priority-changed','task-project-changed'].every(type=>types.includes(type))));
      await this.test('Rule Trigger','TaskCreated does not fire TaskCompleted',()=>{const created=engine.diffStore('tasks',new Map(),new Map([[taskBefore.id,taskBefore]])).map(x=>x.type);this.assert(created.includes('task-created')&&!created.includes('task-completed'))});
      const ops=[['equals','A','A'],['not-equals','A','B'],['gt',5,4],['gte',5,5],['lt',4,5],['lte',5,5],['in','A',['A','B']],['not-in','C',['A','B']],['exists','x',''],['not-exists','',null],['contains','Finance planning','finance'],['before','08:00','09:00'],['after','10:00','09:00'],['date-range','2030-01-02',['2030-01-01','2030-01-03']]];
      for(const [operator,a,b] of ops)await this.test('Rule Conditions',operator,()=>this.assert(engine.compare(a,operator,b)===true));
      const conditionContext={task:{id:'condition-task',priority:'Critical',status:'Next'},data:{tasks:[],events:[],projects:[],activityLog:[],timeBlocks:[],dailyCheckins:[],focusSessions:[]},settings:{},capacity:{focusRemaining:100},profile:'Off',time:'10:00',flexibleFocus:0,recoveryState:'None',stability:100};
      await this.test('Rule Conditions','ALL semantics',()=>this.assert(engine.evaluate(DataValidator.rule(valid),engine.makeEvent('task-overdue','tasks','condition-task',null,conditionContext.task),conditionContext).matched));
      await this.test('Rule Conditions','ANY semantics',()=>{const anyRule=DataValidator.rule({...valid,id:'rule-any',conditionMode:'any',conditions:[{field:'task.priority',operator:'equals',value:'Low'},{field:'task.status',operator:'equals',value:'Next'}]});this.assert(engine.evaluate(anyRule,engine.makeEvent('task-overdue','tasks','condition-task',null,conditionContext.task),conditionContext).matched)});
      const testTask=await repo.save('tasks',{id:'rule-dry-task',title:'Dry task',status:'Next',priority:'Critical',estimatedDuration:30,minimumSessionDuration:15,maximumSessionDuration:60,blockedBy:[],deadline:CoreUtil.localDate()}),testRule=DataValidator.rule({...valid,id:'rule-dry',name:'Dry run rule'}),event=engine.makeEvent('task-overdue','tasks',testTask.id,null,testTask,{eventId:'rule-dry-event'}),beforeHash=CoreUtil.hash(await repo.dataset({fresh:true})),dry=await engine.testRule(testRule,event),afterHash=CoreUtil.hash(await repo.dataset({fresh:true}));
      await this.test('Rule Dry Run','DB hash unchanged',()=>this.assert(beforeHash===afterHash&&dry.productionChanges===0&&dry.dbHashBefore===dry.dbHashAfter));
      const data=await repo.dataset({fresh:true}),settings={...(await repo.settings()),normalDayBedtime:'23:30',normalDayWakeTime:'07:00'},safetyContext={task:testTask,data,settings,capacity:CapacityEngine.summary(CoreUtil.localDate(),data,settings),profile:'Off',time:'10:00',flexibleFocus:0,recoveryState:'None',stability:100},sleepRule=DataValidator.rule({...valid,id:'rule-sleep',name:'Sleep guard',actions:[{type:'schedule-earliest-tomorrow',params:{}}],executionPolicy:'ask'}),sleepPlan=engine.evaluate(sleepRule,event,safetyContext);
      await this.test('Rule Safety','protected sleep blocks earliest tomorrow action',()=>this.assert(sleepPlan.hardBlockers.includes('Protected sleep')));
      const high=engine.evaluate(DataValidator.rule({...valid,id:'rule-conflict-a',name:'A',priority:90,actions:[{type:'change-priority',params:{priority:'Critical'}}]}),event,safetyContext),low=engine.evaluate(DataValidator.rule({...valid,id:'rule-conflict-b',name:'B',priority:40,actions:[{type:'change-priority',params:{priority:'Low'}}]}),event,safetyContext),resolved=engine.resolveConflicts([low,high]);
      await this.test('Rule Conflict Resolution','higher priority wins competing field',()=>this.assert(resolved.find(p=>p.rule.id==='rule-conflict-a').proposedActions.length===1&&resolved.find(p=>p.rule.id==='rule-conflict-b').proposedActions.length===0));
      const tieA=engine.evaluate(DataValidator.rule({...valid,id:'aa',name:'Tie A',priority:50,createdAt:'2020-01-01T00:00:00Z',actions:[{type:'change-priority',params:{priority:'High'}}]}),event,safetyContext),tieB=engine.evaluate(DataValidator.rule({...valid,id:'bb',name:'Tie B',priority:50,createdAt:'2020-01-01T00:00:00Z',actions:[{type:'change-priority',params:{priority:'Low'}}]}),event,safetyContext),ties=engine.resolveConflicts([tieB,tieA]);
      await this.test('Rule Conflict Resolution','equal-priority tie is deterministic',()=>this.assert(ties.find(p=>p.rule.id==='aa').proposedActions.length===1&&ties.find(p=>p.rule.id==='bb').proposedActions.length===0));
      const dupA=engine.evaluate(DataValidator.rule({...valid,id:'dup-a',name:'Dup A',priority:60,actions:[{type:'create-notification',params:{title:'Same'}}]}),event,safetyContext),dupB=engine.evaluate(DataValidator.rule({...valid,id:'dup-b',name:'Dup B',priority:50,actions:[{type:'create-notification',params:{title:'Same'}}]}),event,safetyContext),dups=engine.resolveConflicts([dupB,dupA]);
      await this.test('Rule Conflict Resolution','duplicate notification action deduplicated',()=>this.assert(dups.reduce((sum,p)=>sum+p.proposedActions.length,0)===1));
      await this.test('Rule Loop Prevention','maximum chain depth bounded',()=>this.assert(MAX_RULE_CHAIN_DEPTH===5));
      await this.test('Rule Loop Prevention','rule lineage detects A-B-A cycle input',()=>this.assert(['a','b','a'].filter(id=>id==='a').length===2));
      await this.test('Rule Loop Prevention','self retrigger is filtered by source rule id',()=>{const sourceEvent={...event,sourceRuleId:'rule-dry'},rows=[testRule].filter(rule=>!sourceEvent.sourceRuleId||rule.id!==sourceEvent.sourceRuleId);this.assert(rows.length===0)});
      const currentTask=await repo.get('tasks',testTask.id),atomicRule=DataValidator.rule({...valid,id:'rule-atomic',name:'Atomic',actions:[{type:'change-priority',params:{priority:'High'}},{type:'set-context',params:{context:'Study'}}]}),atomicEvent=engine.makeEvent('task-overdue','tasks',currentTask.id,null,currentTask,{eventId:'rule-atomic-event'}),atomicContext={...safetyContext,task:currentTask,data:await repo.dataset({fresh:true})},atomicPlan=engine.evaluate(atomicRule,atomicEvent,atomicContext);atomicPlan.requiresConfirmation=false;atomicPlan.executionPolicy='automatic';await engine.applyPlan(atomicPlan,atomicEvent,atomicContext,{mode:'production'});const mutated=await repo.get('tasks',testTask.id);
      await this.test('Rule Atomic Execution','two task actions commit together',()=>this.assert(mutated.priority==='High'&&mutated.context==='Study'));
      const undo=new UndoManager(repo);await undo.undo();const restored=await repo.get('tasks',testTask.id);
      await this.test('Rule Undo','one Undo restores automation mutation',()=>this.assert(restored.priority==='Critical'&&restored.context!=='Study'));
      await this.test('Rule Concurrency','event identity stable by revision',()=>this.assert(engine.makeEvent('task-updated','tasks','x',null,{id:'x',revision:7}).eventId==='task-updated:tasks:x:7'));
      await this.test('Rule Concurrency','processed event memory is bounded',()=>this.assert(RULE_EVENT_MEMORY_LIMIT===250));
      await this.test('Rule Audit','bounded history limit configured',()=>this.assert(RULE_HISTORY_LIMIT===250));
      const template=await engine.installTemplate('critical-deadline');
      await this.test('Planning Policies','template installs visible disabled rule',()=>this.assert(template.source==='template'&&!template.enabled));
      await this.test('Rule Intelligence Integration','provenance retained',()=>{const r=DataValidator.rule({...valid,id:'intel-rule',source:'intelligence',sourceInsightId:'insight-1',intelligenceModelVersion:INTELLIGENCE_MODEL_VERSION,createdFromEvidenceAt:CoreUtil.nowISO()});this.assert(r.sourceInsightId==='insight-1'&&r.intelligenceModelVersion==='4.4.2')});
      const owned=await repo.save('rules',{...valid,id:'owned-rule',name:'Owned',source:'intelligence',sourceInsightId:'gone-insight'});
      await this.test('Rule Intelligence Integration','rule remains when source insight disappears',async()=>this.assert(Boolean(await repo.get('rules',owned.id))));
      const scenarioBefore=CoreUtil.hash(await repo.dataset({fresh:true})),scenarioResult=await engine.testRule(testRule,event,{data:CoreUtil.clone(await repo.dataset({fresh:true})),settings:await repo.settings(),mode:'scenario'}),scenarioAfter=CoreUtil.hash(await repo.dataset({fresh:true}));
      await this.test('Rule Scenario Integration','scenario dry run leaves production unchanged',()=>this.assert(scenarioBefore===scenarioAfter&&scenarioResult.productionChanges===0));
      const backup=new BackupManager(repo,new SnapshotManager(repo),new OperationJournal(repo)),exported=await backup.exportObject();
      await this.test('Rule Backup','rules store is included in backup',()=>this.assert(Array.isArray(exported.stores.rules)&&exported.stores.rules.some(rule=>rule.id==='owned-rule')));
      const broken=DataValidator.rule({...valid,id:'broken-project-rule',name:'Broken reference',conditions:[{field:'task.projectId',operator:'equals',value:'missing-project'}]});await repo.save('rules',broken);const integrity=await new IntegrityEngine(repo).run();
      await this.test('Rule Integrity','missing project reference is diagnosed',()=>this.assert(integrity.issues.some(issue=>issue.code==='INTEGRITY-RULE-PROJECT-015')));
      await this.test('Rule Security','no arbitrary execution action exists',()=>this.assert(!Object.keys(RULE_ACTIONS).some(key=>/javascript|script|eval|function|http|api|email|slack|bank|medical/i.test(key))));
      await this.test('Rule Privacy','automation registries are local-only',()=>this.assert(!JSON.stringify({RULE_TRIGGERS,RULE_CONDITIONS,RULE_ACTIONS}).includes('https://')));
      await this.test('Rule Accessibility','builder is semantically grouped',()=>{const source=App.prototype.openRule.toString();this.assert(source.includes('<fieldset>')&&source.includes('<legend>')&&source.includes('aria-live'))});
      for(const count of [100,500,1000])await this.test('Rule Performance',`${count} rule indexing`,async()=>{const rules=Array.from({length:count},(_,i)=>DataValidator.rule({...valid,id:`perf-${count}-${i}`,name:`Performance ${i}`,trigger:{type:i%2?'task-updated':'planning-refresh'}})),fake={all:async()=>rules},perf=new RuleEngine(fake),started=performance.now();await perf.reindex();this.assert(perf.index.get('task-updated').length>0&&performance.now()-started<1000)});
      await this.test('Rule Performance','100 active trigger lookup target',async()=>{const rules=Array.from({length:100},(_,i)=>DataValidator.rule({...valid,id:`lookup-${i}`,name:`Lookup ${i}`,trigger:{type:'task-updated'}})),fake={all:async()=>rules},perf=new RuleEngine(fake);await perf.reindex();const started=performance.now(),candidates=perf.index.get('task-updated');this.assert(candidates.length===100&&performance.now()-started<50)});
    }
