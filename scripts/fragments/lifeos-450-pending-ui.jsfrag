    async openPendingRule(executionId){const pending=(await this.ruleEngine.pendingApprovals()).find(row=>row.executionId===executionId);if(!pending)return;const body=`<div class="note"><b>Automation is waiting for your approval.</b><p>${CoreUtil.escape(pending.ruleName)}</p></div><dl class="evidence-grid"><div><dt>Trigger</dt><dd>${CoreUtil.escape(this.ruleLabel(pending.triggerType,RULE_TRIGGERS))}</dd></div><div><dt>Created</dt><dd>${CoreUtil.formatDateTime(pending.createdAt)}</dd></div><div><dt>Affected entities</dt><dd>${CoreUtil.array(pending.affectedEntities).length}</dd></div><div><dt>Risk</dt><dd>${CoreUtil.escape(pending.proposedActions.map(action=>action.risk).join(', ')||'LOW')}</dd></div></dl><h3>Proposed actions</h3><ul>${pending.proposedActions.map(action=>`<li><b>${CoreUtil.escape(action.label)}</b>${action.risk==='HIGH'?' · High impact':''}${action.params?.resolvedDate?' · '+CoreUtil.escape(action.params.resolvedDate+' '+action.params.resolvedTime+' · '+action.params.duration+' min'):''}</li>`).join('')}</ul>${pending.warnings.length?`<div class="warning-box"><b>Warnings</b><ul>${pending.warnings.map(value=>`<li>${CoreUtil.escape(value)}</li>`).join('')}</ul></div>`:''}<p class="muted">Before applying, LifeOS reloads the affected record and rejects the approval as stale if its revision changed.</p><div class="dialog-foot embedded-dialog-foot"><button class="btn" data-action="reject-pending-rule" data-id="${CoreUtil.escape(executionId)}">Reject</button><button class="btn primary" data-action="apply-pending-rule" data-id="${CoreUtil.escape(executionId)}">Apply</button></div>`;this.modal.open('Review Automation',body,'',{subtitle:'Explicit approval · stale-revision protected'})}
    async applyPendingRule(executionId){const result=await this.ruleEngine.confirmPending(executionId);this.modal.close();await this.notifications.notify(result.status==='Applied'?'SUCCESS':result.status==='Stale'?'WARNING':'INFO','Automation '+result.status,String(result.status==='Stale'?'The underlying data changed; the automation was not applied.':'LifeOS finished the approval safely.'),{persist:true});await this.render()}
    async rejectPendingRule(executionId){await this.ruleEngine.rejectPending(executionId);this.modal.close();await this.notifications.notify('INFO','Automation rejected','No proposed changes were applied.',{persist:true});await this.render()}
