    async pendingApprovals(){const state=await this.runtime();return CoreUtil.array(state.pendingApprovals).sort((a,b)=>String(b.createdAt).localeCompare(String(a.createdAt)))}
    async storePending(plan,event){const state=await this.runtime(),entry={executionId:plan.executionId,planId:plan.planId,ruleId:plan.rule.id,ruleName:plan.rule.name,triggerEventId:event.eventId,triggerType:event.type,event:CoreUtil.clone(event),affectedEntities:CoreUtil.clone(plan.affectedEntities),proposedActions:plan.proposedActions.map(action=>({type:action.type,params:CoreUtil.clone(action.params),risk:action.definition?.risk||'LOW',label:action.definition?.label||action.type})),warnings:CoreUtil.clone(plan.warnings),hardBlockers:CoreUtil.clone(plan.hardBlockers),fingerprint:plan.fingerprint,createdAt:CoreUtil.nowISO(),status:'Awaiting confirmation'},pending=[...CoreUtil.array(state.pendingApprovals).filter(row=>row.executionId!==plan.executionId),entry].slice(-50);await this.repo.save('systemMeta',{...state,id:'rule-runtime',pendingApprovals:pending,schemaVersion:RULE_SCHEMA_VERSION},{validate:false});return entry}
    async removePending(executionId){const state=await this.runtime(),pending=CoreUtil.array(state.pendingApprovals).filter(row=>row.executionId!==executionId);await this.repo.save('systemMeta',{...state,id:'rule-runtime',pendingApprovals:pending,schemaVersion:RULE_SCHEMA_VERSION},{validate:false})}
    async confirmPending(executionId){const execute=async()=>{const state=await this.runtime(),pending=CoreUtil.array(state.pendingApprovals).find(row=>row.executionId===executionId);if(!pending)return{status:'Missing'};const rule=await this.repo.get('rules',pending.ruleId);if(!rule){await this.removePending(executionId);await this.audit(null,pending.event,'Stale',[],['Rule no longer exists.'],{executionId,conditionResults:[],warnings:[]});return{status:'Stale'}}const data=await this.repo.dataset({fresh:true}),settings=await this.repo.settings(),event=CoreUtil.clone(pending.event),affected=CoreUtil.array(pending.affectedEntities)[0];if(affected?.type==='task'){const current=data.tasks.find(row=>row.id===affected.id);if(!current||CoreUtil.num(current.revision)!==CoreUtil.num(affected.revision)){await this.removePending(executionId);await this.audit(rule,event,'Stale',pending.proposedActions,['Task changed after the automation preview. Review the rule again.'],{executionId,conditionResults:[],warnings:[]});return{status:'Stale'}}event.current=current}const context=this.context(event,data,settings),plan=this.evaluate(DataValidator.rule(rule),event,context);plan.executionId=executionId;plan.planId=pending.planId;plan.requiresConfirmation=false;plan.executionPolicy='automatic';if(!plan.matched){await this.removePending(executionId);await this.audit(rule,event,'Stale',pending.proposedActions,['Conditions no longer match.'],plan);return{status:'Stale',plan}}if(plan.hardBlockers.length){await this.removePending(executionId);await this.audit(rule,event,'Blocked',plan.proposedActions,plan.hardBlockers,plan);return{status:'Blocked',plan}}try{const result=await this.applyPlan(plan,event,context,{mode:'production',confirmed:true});await this.removePending(executionId);return result}catch(error){await this.removePending(executionId);if(['DATA-STALE-010','UNDO-REVISION-001','SCENARIO-STALE-001'].includes(error.code)){await this.audit(rule,event,'Stale',plan.proposedActions,[error.message],plan);return{status:'Stale',plan,errorCode:error.code}}throw error}};return this.operationLocks.withExclusiveLock('Rule approval',execute)}
    async rejectPending(executionId){const state=await this.runtime(),pending=CoreUtil.array(state.pendingApprovals).find(row=>row.executionId===executionId);if(!pending)return{status:'Missing'};const rule=await this.repo.get('rules',pending.ruleId);await this.removePending(executionId);await this.audit(rule,pending.event,'Skipped',pending.proposedActions,['User rejected the proposed automation.'],{executionId,conditionResults:[],warnings:[]});return{status:'Skipped'}}
    async planningPolicies(){const rules=await this.repo.all('rules',{fresh:true});return rules.filter(rule=>rule.enabled&&CoreUtil.array(rule.actions).some(action=>action.type==='planning-preference')).map(rule=>({ruleId:rule.id,name:rule.name,priority:rule.priority,conditions:CoreUtil.clone(rule.conditions),actions:CoreUtil.clone(rule.actions.filter(action=>action.type==='planning-preference'))})).sort((a,b)=>b.priority-a.priority||String(a.ruleId).localeCompare(String(b.ruleId)))}
