    ruleLabel(id,registry){return registry[id]?.label||String(id||'').replaceAll('-',' ')}
    ruleOperatorLabel(value){return({equals:'equals','not-equals':'does not equal',in:'is one of','not-in':'is not one of',gt:'greater than',gte:'greater than or equal',lt:'less than',lte:'less than or equal',exists:'exists','not-exists':'does not exist',contains:'contains',before:'before',after:'after','within-next-days':'within next N days','date-range':'within date range'})[value]||value}
    ruleSummary(rule){const conditions=CoreUtil.array(rule.conditions).slice(0,4).map(c=>this.ruleLabel(c.field,RULE_CONDITIONS)+' '+this.ruleOperatorLabel(c.operator)+' '+(Array.isArray(c.value)?c.value.join(', '):String(c.value??''))),actions=CoreUtil.array(rule.actions).map(a=>this.ruleLabel(a.type,RULE_ACTIONS));return{conditions,actions}}
    async renderRules(){
      const rules=(await this.repo.all('rules',{fresh:true})).map(rule=>{try{return DataValidator.rule(rule)}catch{return{...rule,needsAttention:true}}});
      const history=await this.ruleEngine.history(40),filter=this.state.get('ruleFilter')||'all',query=String(this.state.get('ruleSearch')||'').toLowerCase();
      const matchesFilter=rule=>filter==='all'||filter==='active'&&rule.enabled||filter==='disabled'&&!rule.enabled||filter==='attention'&&rule.needsAttention||filter==='recent'&&history.some(row=>row.meta.ruleExecution.ruleId===rule.id)||filter==='never'&&!rule.lastTriggeredAt||filter==='intelligence'&&rule.source==='intelligence';
      const visible=rules.filter(rule=>matchesFilter(rule)&&(!query||[rule.name,rule.trigger?.type,...CoreUtil.array(rule.actions).map(a=>a.type)].join(' ').toLowerCase().includes(query)));
      const active=rules.filter(r=>r.enabled).length,attention=rules.filter(r=>r.needsAttention).length,pending=history.filter(row=>row.meta.ruleExecution.status==='Awaiting confirmation').length,blocked=history.filter(row=>row.meta.ruleExecution.status==='Blocked').length;
      return`<div class="section-head"><div><h1>Rules & Automation</h1><p class="muted">Deterministic local rules. Every rule is visible, testable, disableable and auditable.</p></div><div class="actions"><button class="btn" data-action="rule-templates">Templates</button><button class="btn primary" data-action="new-rule">Create Rule</button></div></div>
      <div class="note" role="status"><b>Execution reality</b> · Rules run while LifeOS is active or at the next supported refresh. LifeOS does not claim always-on execution while the browser is fully closed.</div>
      <div class="grid grid-4 flow-gap-14"><div class="card"><div class="metric">${active}</div><div class="metric-label">Active rules</div></div><div class="card"><div class="metric">${rules.length-active}</div><div class="metric-label">Disabled rules</div></div><div class="card"><div class="metric">${attention+pending}</div><div class="metric-label">Needs attention / approvals</div></div><div class="card"><div class="metric">${blocked}</div><div class="metric-label">Blocked automations</div></div></div>
      <section class="card rule-toolbar"><div class="rule-filter-row"><input type="search" id="ruleSearch" value="${CoreUtil.escape(this.state.get('ruleSearch')||'')}" placeholder="Search rules, triggers or actions" aria-label="Search rules"><div class="segmented" role="group" aria-label="Rule filter">${[['all','All'],['active','Active'],['disabled','Disabled'],['attention','Needs attention'],['recent','Recently triggered'],['never','Never triggered'],['intelligence','From Intelligence']].map(([id,label])=>`<button data-action="rule-filter" data-filter="${id}" aria-pressed="${filter===id}">${label}</button>`).join('')}</div></div>${this.selectedRules.size?`<div class="actions rule-bulk" role="status"><b>${this.selectedRules.size} selected</b><button class="btn small" data-action="bulk-rules-enable">Enable selected</button><button class="btn small" data-action="bulk-rules-disable">Disable selected</button><button class="btn small danger" data-action="bulk-rules-delete">Delete selected</button></div>`:''}</section>
      ${visible.length?`<div class="grid grid-2">${visible.map(rule=>this.ruleCard(rule,history)).join('')}</div>`:this.empty('No rules match this view','Create a rule or install an editable template.','new-rule','Create Rule','⚡')}
      <section class="card flow-gap-14"><div class="card-head"><div><h2>Recent execution history</h2><p class="muted">Bounded local audit history. No telemetry leaves this device.</p></div><button class="btn small" data-action="rule-history">Open history</button></div>${history.length?`<div class="list">${history.slice(0,8).map(row=>{const x=row.meta.ruleExecution;return`<div class="item"><div class="item-main"><b>${CoreUtil.escape(x.ruleName||'Rule')}</b><div class="item-meta"><span>${CoreUtil.escape(x.status)}</span><span>${CoreUtil.escape(this.ruleLabel(x.triggerType,RULE_TRIGGERS))}</span><span>${CoreUtil.formatDateTime(row.at)}</span></div></div></div>`}).join('')}</div>`:'<p class="muted">No rule executions yet.</p>'}</section>`
    }
    ruleCard(rule,history){const summary=this.ruleSummary(rule),last=history.find(row=>row.meta.ruleExecution.ruleId===rule.id),checked=this.selectedRules.has(rule.id);return`<article class="card rule-card" tabindex="-1" data-rule-card="${CoreUtil.escape(rule.id)}"><div class="card-head"><div><label class="rule-select"><input type="checkbox" data-rule-select="${CoreUtil.escape(rule.id)}" ${checked?'checked':''} aria-label="Select ${CoreUtil.escape(rule.name)}"><span></span></label><div class="eyebrow">${CoreUtil.escape(this.ruleLabel(rule.trigger?.type,RULE_TRIGGERS))}</div><h2>${CoreUtil.escape(rule.name||'Invalid rule')}</h2></div>${this.pill(rule.needsAttention?'Needs attention':rule.enabled?'Active':'Disabled',rule.needsAttention?'warning':rule.enabled?'success':'')}</div><p>${CoreUtil.escape(rule.description||'Visible structured LifeOS rule.')}</p><dl class="rule-summary"><div><dt>When</dt><dd>${CoreUtil.escape(this.ruleLabel(rule.trigger?.type,RULE_TRIGGERS))}</dd></div><div><dt>If</dt><dd>${summary.conditions.length?summary.conditions.map(CoreUtil.escape).join(' · '):'No additional conditions'}</dd></div><div><dt>Then</dt><dd>${summary.actions.map(CoreUtil.escape).join(' · ')}</dd></div><div><dt>Execution</dt><dd>${CoreUtil.escape(rule.executionPolicy||'ask')}</dd></div><div><dt>Priority</dt><dd>${CoreUtil.num(rule.priority,50)}</dd></div><div><dt>Last triggered</dt><dd>${rule.lastTriggeredAt?CoreUtil.formatDateTime(rule.lastTriggeredAt):last?CoreUtil.formatDateTime(last.at):'Never'}</dd></div></dl>${rule.source==='intelligence'?`<div class="note"><b>Created from Personal Intelligence</b>${rule.sourceInsightId?` · ${CoreUtil.escape(rule.sourceInsightId)}`:''}</div>`:''}<div class="actions flow-gap-10"><button class="btn small primary" data-action="test-rule" data-id="${CoreUtil.escape(rule.id)}">Test Rule</button><button class="btn small" data-action="edit-rule" data-id="${CoreUtil.escape(rule.id)}">Edit</button><button class="btn small" data-action="rule-toggle" data-id="${CoreUtil.escape(rule.id)}" data-enabled="${rule.enabled?'false':'true'}">${rule.enabled?'Disable':'Enable'}</button><button class="btn small" data-action="duplicate-rule" data-id="${CoreUtil.escape(rule.id)}">Duplicate</button><button class="btn small danger" data-action="delete-rule" data-id="${CoreUtil.escape(rule.id)}">Delete</button></div></article>`}
    ruleConditionRow(condition={}){const value={field:'task.priority',operator:'equals',value:'High',...condition},fields=Object.entries(RULE_CONDITIONS).map(([id,definition])=>`<option value="${id}" ${id===value.field?'selected':''}>${CoreUtil.escape(definition.label)}</option>`).join(''),operators=[...new Set(Object.values(RULE_OPERATORS).flat())].map(operator=>`<option value="${operator}" ${operator===value.operator?'selected':''}>${CoreUtil.escape(this.ruleOperatorLabel(operator))}</option>`).join(''),raw=Array.isArray(value.value)?value.value.join(', '):String(value.value??'');return`<div class="rule-builder-row" data-rule-condition><label>Field<select name="ruleConditionField">${fields}</select></label><label>Operator<select name="ruleConditionOperator">${operators}</select></label><label>Value<input name="ruleConditionValue" value="${CoreUtil.escape(raw)}" placeholder="Value"></label><button type="button" class="btn small danger" data-action="remove-rule-condition" aria-label="Remove condition">Remove</button></div>`}
    ruleActionRow(action={}){const value={type:'create-notification',params:{},...action},actions=Object.entries(RULE_ACTIONS).map(([id,definition])=>`<option value="${id}" ${id===value.type?'selected':''}>${CoreUtil.escape(definition.label)} · ${definition.risk}</option>`).join(''),p=value.params||{},raw=p.title||p.level||p.priority||p.date||p.time||p.context||p.mode||p.projectId||p.kind||p.minutes||'';return`<div class="rule-builder-row" data-rule-action><label>Action<select name="ruleActionType">${actions}</select></label><label>Action value<input name="ruleActionValue" value="${CoreUtil.escape(String(raw))}" placeholder="Optional value"></label><button type="button" class="btn small danger" data-action="remove-rule-action" aria-label="Remove action">Remove</button></div>`}
    async openRule(record={}){const rule={id:record.id||'',name:record.name||'',description:record.description||'',enabled:record.enabled===true,trigger:record.trigger||{type:'task-overdue',config:{}},conditionMode:record.conditionMode||'all',conditions:CoreUtil.array(record.conditions),actions:CoreUtil.array(record.actions).length?record.actions:[{type:'surface-what-now',params:{level:'attention'}}],priority:record.priority??50,executionPolicy:record.executionPolicy||'ask',source:record.source||'manual',sourceInsightId:record.sourceInsightId||'',intelligenceModelVersion:record.intelligenceModelVersion||'',createdFromEvidenceAt:record.createdFromEvidenceAt||'',revision:record.revision||''},triggers=Object.entries(RULE_TRIGGERS).map(([id,definition])=>`<option value="${id}" ${id===rule.trigger.type?'selected':''}>${CoreUtil.escape(definition.label)}</option>`).join(''),body=`<form data-form="rule" id="ruleForm"><input type="hidden" name="id" value="${CoreUtil.escape(rule.id)}"><input type="hidden" name="loadedRevision" value="${CoreUtil.escape(rule.revision)}"><input type="hidden" name="source" value="${CoreUtil.escape(rule.source)}"><input type="hidden" name="sourceInsightId" value="${CoreUtil.escape(rule.sourceInsightId)}"><input type="hidden" name="intelligenceModelVersion" value="${CoreUtil.escape(rule.intelligenceModelVersion)}"><input type="hidden" name="createdFromEvidenceAt" value="${CoreUtil.escape(rule.createdFromEvidenceAt)}"><div class="rule-builder"><fieldset><legend>1. Name</legend><label class="field">Rule name<input name="name" required autofocus value="${CoreUtil.escape(rule.name)}"></label><label class="field">Description<textarea name="description">${CoreUtil.escape(rule.description)}</textarea></label></fieldset><fieldset><legend>2. Trigger</legend><label class="field">WHEN<select name="triggerType">${triggers}</select></label></fieldset><fieldset><legend>3. Conditions</legend><div class="split"><label>Match <select name="conditionMode"><option value="all" ${rule.conditionMode==='all'?'selected':''}>ALL conditions</option><option value="any" ${rule.conditionMode==='any'?'selected':''}>ANY condition</option></select></label><button type="button" class="btn small" data-action="add-rule-condition">Add condition</button></div><div data-rule-conditions>${rule.conditions.map(condition=>this.ruleConditionRow(condition)).join('')}</div></fieldset><fieldset><legend>4. Actions</legend><div class="split"><span>THEN</span><button type="button" class="btn small" data-action="add-rule-action">Add action</button></div><div data-rule-actions>${rule.actions.map(action=>this.ruleActionRow(action)).join('')}</div></fieldset><fieldset><legend>5. Execution</legend><label class="field">Policy<select name="executionPolicy"><option value="automatic" ${rule.executionPolicy==='automatic'?'selected':''}>Automatic</option><option value="ask" ${rule.executionPolicy==='ask'?'selected':''}>Ask before applying</option><option value="suggestion" ${rule.executionPolicy==='suggestion'?'selected':''}>Suggestion only</option></select></label><p class="muted">High-impact actions are safety-validated and require review.</p></fieldset><fieldset><legend>6. Priority</legend><label class="field">Priority 0–100<input type="number" name="priority" min="0" max="100" step="1" value="${rule.priority}"></label></fieldset><fieldset><legend>7. Test</legend><p class="muted">Dry run evaluates the rule without changing production data.</p><button type="button" class="btn" data-action="test-rule-form">Test Rule</button><div class="rule-test-inline" data-rule-test-inline aria-live="polite" tabindex="-1"></div></fieldset><fieldset><legend>8. Review</legend><label class="checks"><input type="checkbox" name="enabled" ${rule.enabled?'checked':''}> Enable after save</label><p class="muted">9. Save only after the trigger, conditions, actions and policy are clear.</p></fieldset></div><div class="dialog-foot embedded-dialog-foot"><button type="button" class="btn" data-action="close-dialog">Cancel</button><button class="btn primary">Save Rule</button></div></form>`;this.modal.open(rule.id?'Edit Rule':'Create Rule',body,'',{subtitle:'Structured domain rules only — no scripts, eval or remote automation.'})}
    ruleFromForm(form){const data=new FormData(form),conditionFields=data.getAll('ruleConditionField'),conditionOps=data.getAll('ruleConditionOperator'),conditionValues=data.getAll('ruleConditionValue'),actionTypes=data.getAll('ruleActionType'),actionValues=data.getAll('ruleActionValue');const conditions=conditionFields.map((field,index)=>{const definition=RULE_CONDITIONS[field],operator=conditionOps[index],raw=conditionValues[index]??'';let value=raw;if(definition?.type==='number'&&raw!=='')value=Number(raw);else if(['in','not-in','date-range'].includes(operator))value=String(raw).split(',').map(x=>x.trim()).filter(Boolean);return{field,operator,value}});const actions=actionTypes.map((type,index)=>{const raw=String(actionValues[index]??'').trim();let params={};if(type==='create-notification')params={title:raw||'LifeOS rule matched'};else if(['surface-what-now','set-attention'].includes(type))params={level:raw==='urgent'?'urgent':'attention'};else if(type==='change-priority')params={priority:raw||'High'};else if(type==='set-preferred-date')params={date:raw};else if(type==='set-preferred-time')params={time:raw,toleranceMinutes:30};else if(type==='set-context')params={context:raw};else if(type==='set-flexibility')params={mode:raw};else if(type==='assign-project')params={projectId:raw};else if(type==='planning-preference')params={kind:raw||'soft-preference'};else if(type==='create-suggested-task')params={title:raw||'Suggested task'};return{type,params}});const raw={id:data.get('id')||CoreUtil.uid(),name:data.get('name'),description:data.get('description'),enabled:data.get('enabled')==='on',trigger:{type:data.get('triggerType'),config:{}},conditionMode:data.get('conditionMode')||'all',conditions,actions,priority:Number(data.get('priority')||50),scope:{},executionPolicy:data.get('executionPolicy')||'ask',source:data.get('source')||'manual',sourceInsightId:data.get('sourceInsightId')||'',intelligenceModelVersion:data.get('intelligenceModelVersion')||'',createdFromEvidenceAt:data.get('createdFromEvidenceAt')||'',schemaVersion:RULE_SCHEMA_VERSION,ruleEngineVersion:RULE_ENGINE_VERSION};if(data.get('loadedRevision'))raw.loadedRevision=Number(data.get('loadedRevision'));return DataValidator.rule(raw)}
    async saveRuleForm(form){const rule=this.ruleFromForm(form),loaded=Number(new FormData(form).get('loadedRevision')||0),existing=loaded?await this.repo.get('rules',rule.id):null;if(existing)await this.repo.saveIfRevisionMatches('rules',rule,loaded);else await this.ruleEngine.save(rule);this.modal.close();await this.render();document.querySelector(`[data-rule-card="${CSS.escape(rule.id)}"]`)?.focus()}
    addRuleCondition(){document.querySelector('[data-rule-conditions]')?.insertAdjacentHTML('beforeend',this.ruleConditionRow())}
    addRuleAction(){document.querySelector('[data-rule-actions]')?.insertAdjacentHTML('beforeend',this.ruleActionRow())}
    async dryRunRuleFromForm(form){try{const rule=this.ruleFromForm(form),data=await this.data(),entityType=RULE_TRIGGERS[rule.trigger.type]?.entityType,rows=entityType==='task'?data.tasks:entityType==='project'?data.projects:entityType==='event'?data.events:[],entity=rows.find(row=>!['Completed','Cancelled'].includes(row.status))||rows[0]||null,event=this.ruleEngine.makeEvent(rule.trigger.type,entityType==='task'?'tasks':entityType==='project'?'projects':entityType==='event'?'events':'planning',entity?.id||'builder-test',null,entity,{eventId:`builder-test:${rule.id}`}),result=await this.ruleEngine.testRule(rule,event),box=form.querySelector('[data-rule-test-inline]');box.className='rule-test-inline note';box.innerHTML=`<b>Rule test complete.</b><div>Trigger matched: ${result.plan.matched?'Yes':'No'}</div><div>Conditions: ${result.plan.conditionResults.filter(row=>row.matched).length} / ${result.plan.conditionResults.length} matched</div><div>Actions that would run: ${result.plan.proposedActions.length}</div><div>Hard blockers: ${result.plan.hardBlockers.length?CoreUtil.escape(result.plan.hardBlockers.join(' · ')):'None'}</div><div>Production data changes: ${result.productionChanges}</div>`;box.focus()}catch(error){this.showFormError(form,error)}}
    async openRuleTest(ruleId){const rule=await this.repo.get('rules',ruleId);if(!rule)return;const data=await this.data(),entityType=RULE_TRIGGERS[rule.trigger.type]?.entityType,rows=entityType==='task'?data.tasks:entityType==='project'?data.projects:entityType==='event'?data.events:[],scenarios=await this.scenarioEngine.list(),body=`<form data-form="rule-test"><input type="hidden" name="ruleId" value="${CoreUtil.escape(rule.id)}">${rows.length?`<label class="field">Test against existing ${CoreUtil.escape(entityType)}<select name="entityId">${rows.map(row=>`<option value="${CoreUtil.escape(row.id)}">${CoreUtil.escape(row.title||row.name||row.id)}</option>`).join('')}</select></label>`:'<p class="muted">This trigger uses planning context rather than one entity.</p>'}<label class="field">Mode<select name="testMode"><option value="dry-run">Production dry run</option>${scenarios.length?'<option value="scenario">Scenario</option>':''}</select></label>${scenarios.length?`<label class="field">Scenario<select name="scenarioId">${scenarios.map(row=>`<option value="${row.id}">${CoreUtil.escape(row.name)}</option>`).join('')}</select></label>`:''}<div class="note"><b>Safety invariant:</b> production data must have the same hash before and after this test.</div><div class="dialog-foot embedded-dialog-foot"><button type="button" class="btn" data-action="close-dialog">Cancel</button><button class="btn primary">Run Test</button></div></form>`;this.modal.open(`Test Rule · ${rule.name}`,body,'',{subtitle:'No production mutation is allowed.'})}
    async submitRuleTest(form){const values=this.formValues(form),rule=await this.repo.get('rules',values.ruleId);let result;if(values.testMode==='scenario'&&values.scenarioId){const scenario=await this.scenarioEngine.get(values.scenarioId),current=await this.scenarioEngine.currentState(),simulation=ScenarioEngine.deterministic(scenario,current.data,current.settings);result=await this.ruleEngine.testAgainstEntity(rule,values.entityId,{mode:'scenario',data:simulation.scenarioData,settings:simulation.scenarioSettings})}else result=await this.ruleEngine.testAgainstEntity(rule,values.entityId,{mode:'dry-run'});this.showRuleTestResult(rule,result,values.testMode==='scenario'?'Scenario dry run':'Production dry run')}
    showRuleTestResult(rule,result,mode){const plan=result.plan,body=`<div class="note" role="status"><b>Rule test complete.</b> ${CoreUtil.escape(mode)}.</div><dl class="evidence-grid"><div><dt>Trigger matched</dt><dd>${plan.matched?'Yes':'No'}</dd></div><div><dt>Conditions</dt><dd>${plan.conditionResults.filter(row=>row.matched).length} / ${plan.conditionResults.length} matched</dd></div><div><dt>Actions</dt><dd>${plan.proposedActions.length}</dd></div><div><dt>Production changes</dt><dd>${result.productionChanges}</dd></div><div><dt>DB hash before</dt><dd><code>${CoreUtil.escape(result.dbHashBefore)}</code></dd></div><div><dt>DB hash after</dt><dd><code>${CoreUtil.escape(result.dbHashAfter)}</code></dd></div></dl>${plan.proposedActions.length?`<h3>Proposed actions</h3><ul>${plan.proposedActions.map(action=>`<li>${CoreUtil.escape(this.ruleLabel(action.type,RULE_ACTIONS))}</li>`).join('')}</ul>`:''}${plan.hardBlockers.length?`<div class="danger-box"><b>Hard blockers</b><ul>${plan.hardBlockers.map(x=>`<li>${CoreUtil.escape(x)}</li>`).join('')}</ul>`:'<div class="note">Hard blockers: None</div>'}<div class="dialog-foot embedded-dialog-foot"><button class="btn primary" data-action="close-dialog">Close</button></div>`;this.modal.open(`Rule Test · ${rule.name}`,body,'',{subtitle:'Dry-run safety result'})}
    async openRuleTemplates(){const body=`<div class="grid grid-2">${RULE_TEMPLATES.map(template=>`<article class="card"><h3>${CoreUtil.escape(template.name)}</h3><p class="muted">${CoreUtil.escape(this.ruleLabel(template.trigger,RULE_TRIGGERS))} · Priority ${template.priority} · ${CoreUtil.escape(template.executionPolicy)}</p><button class="btn small primary" data-action="install-rule-template" data-id="${template.id}">Install editable template</button></article>`).join('')}</div><div class="dialog-foot embedded-dialog-foot"><button class="btn" data-action="close-dialog">Close</button></div>`;this.modal.open('Rule Templates',body,'',{subtitle:'Templates install as visible disabled rules for review.'})}
    async openRuleHistory(){const history=await this.ruleEngine.history(),body=history.length?`<div class="list">${history.map(row=>{const x=row.meta.ruleExecution;return`<article class="item"><div class="item-main"><b>${CoreUtil.escape(x.ruleName||'Rule')}</b><div class="item-meta"><span>${CoreUtil.escape(x.status)}</span><span>${CoreUtil.escape(this.ruleLabel(x.triggerType,RULE_TRIGGERS))}</span><span>${CoreUtil.formatDateTime(row.at)}</span></div>${CoreUtil.array(x.blockers).length?`<div class="muted">Blocked: ${CoreUtil.escape(x.blockers.join(' · '))}</div>`:''}</div></article>`}).join('')}</div>`:'<p class="muted">No rule history yet.</p>';this.modal.open('Rule execution history',body+'<div class="dialog-foot embedded-dialog-foot"><button class="btn" data-action="close-dialog">Close</button></div>','',{subtitle:'Bounded local audit history'})}
    async confirmRuleDelete(id){const rule=await this.repo.get('rules',id);if(!rule)return;this.modal.open('Delete Rule',`<p>Delete <b>${CoreUtil.escape(rule.name)}</b>?</p><p class="muted">Disable it instead if you want to keep the definition.</p><div class="dialog-foot embedded-dialog-foot"><button class="btn" data-action="close-dialog">Cancel</button><button class="btn danger" data-action="confirm-delete-rule" data-id="${CoreUtil.escape(id)}">Delete Rule</button></div>`) }
    async bulkRuleChange(mode){const ids=[...this.selectedRules],rules=(await Promise.all(ids.map(id=>this.repo.get('rules',id)))).filter(Boolean);if(!rules.length)return;const changes=rules.map(rule=>({store:'rules',id:rule.id,before:rule,after:mode==='delete'?null:this.repo.stamp('rules',{...rule,enabled:mode==='enable',needsAttention:false},rule)}));await this.undo.execute(mode==='delete'?'Delete selected rules':mode==='enable'?'Enable selected rules':'Disable selected rules',changes,{activityType:'rule-bulk'});this.selectedRules.clear();await this.ruleEngine.reindex();await this.render()}
    insightRuleSuggestion(insight){if(!insight)return null;const base={id:CoreUtil.uid(),enabled:true,description:'Created from a reviewed LifeOS Personal Intelligence suggestion.',conditionMode:'all',scope:{},priority:60,executionPolicy:'ask',source:'intelligence',sourceInsightId:insight.insightId,intelligenceModelVersion:INTELLIGENCE_MODEL_VERSION,createdFromEvidenceAt:CoreUtil.nowISO(),schemaVersion:RULE_SCHEMA_VERSION,ruleEngineVersion:RULE_ENGINE_VERSION};if(insight.insightType==='repeated-postponement')return{...base,name:'Repeated Postponement Attention',trigger:{type:'task-postponed',config:{}},conditions:[{field:'task.postponeCount',operator:'gte',value:2}],actions:[{type:'surface-what-now',params:{level:'urgent'}}],priority:80,executionPolicy:'automatic'};if(insight.insightType==='postponement-time-window')return{...base,name:`Earlier ${insight.sourceDimensions?.taskType||'task'} planning preference`,trigger:{type:'task-updated',config:{}},conditions:[{field:'task.taskType',operator:'equals',value:insight.sourceDimensions?.taskType||''}],actions:[{type:'planning-preference',params:{kind:'preferred-before',time:'17:00',taskType:insight.sourceDimensions?.taskType||''}}]};if(insight.insightType==='day-profile-load')return{...base,name:'Day Profile Load Protection',trigger:{type:'planning-refresh',config:{}},conditions:[{field:'day.profile',operator:'equals',value:insight.sourceDimensions?.dayProfile||'Work'},{field:'capacity.flexibleFocus',operator:'gt',value:150}],actions:[{type:'create-notification',params:{title:'Day plan is unusually heavy'}}],priority:65,executionPolicy:'automatic'};return{...base,name:`Review ${insight.title}`,trigger:{type:'planning-refresh',config:{}},conditions:[],actions:[{type:'create-notification',params:{title:'Review an established LifeOS pattern'}}],executionPolicy:'suggestion'}}
    async previewInsightRule(id){const insight=this.intelligenceAnalysis?.insights?.find(row=>row.insightId===id);if(!insight||!['established','strong'].includes(insight.evidence?.level))throw CoreUtil.error('RULE-INTELLIGENCE-001','Only established evidence can suggest a rule.');const rule=DataValidator.rule(this.insightRuleSuggestion(insight));this.pendingRuleSuggestion=rule;const summary=this.ruleSummary(rule),body=`<div class="note"><b>Insight → suggested rule</b><p>${CoreUtil.escape(insight.statement||insight.title)}</p></div><h3>${CoreUtil.escape(rule.name)}</h3><p><b>WHEN</b> ${CoreUtil.escape(this.ruleLabel(rule.trigger.type,RULE_TRIGGERS))}</p><p><b>IF</b> ${CoreUtil.escape(summary.conditions.join(' · ')||'No additional conditions')}</p><p><b>THEN</b> ${CoreUtil.escape(summary.actions.join(' · '))}</p><p class="muted">The rule does not exist yet. Creating it requires explicit confirmation. If the source insight later disappears, the rule remains yours.</p><div class="dialog-foot embedded-dialog-foot"><button class="btn" data-action="close-dialog">Cancel</button><button class="btn primary" data-action="confirm-insight-rule">Create visible rule</button></div>`;this.modal.open('Review suggested rule',body,'',{subtitle:'Personal Intelligence never auto-creates rules.'})}
    async confirmInsightRule(){if(!this.pendingRuleSuggestion)return;const rule=await this.ruleEngine.save(this.pendingRuleSuggestion);this.pendingRuleSuggestion=null;this.modal.close();await this.setView('rules');await this.notifications.notify('SUCCESS','Rule created',`${rule.name} is now visible in Rules & Automation.`,{persist:true})}
